# Copy to .env and edit. Never commit .env. No real secrets belong in this example file.
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./artifacts/eagle_eye.sqlite3
UPLOAD_DIR=./artifacts/uploads
MAX_UPLOAD_MB=25
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.csv,.xlsx
MODEL_PATH=./models/custom/best.pt
MODEL_MANIFEST_PATH=./models/custom/model_manifest.json
DETECTION_CONF_THRESHOLD=0.25
DETECTION_ACCEPT_THRESHOLD=0.50
DETECTION_IOU_THRESHOLD=0.70
DETECTION_IMGSZ=640
PROCESSING_TIMEOUT_SECONDS=120
